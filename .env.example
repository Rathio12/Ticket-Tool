# Discord bot token — https://discord.com/developers/applications
DISCORD_TOKEN=

# Prefix for legacy text commands (slash commands are the primary interface)
BOT_PREFIX=!

# Comma-separated Discord user IDs of bot operators. These bypass every
# per-guild staff check and can run global diagnostic commands (!sync,
# !botstats, !test_limits). This is NOT how per-server staff are configured —
# each server configures its own staff role via /setup.
OWNER_IDS=

# Optional: set this to a guild ID while developing to sync slash commands
# to that guild instantly instead of waiting up to an hour for the global
# sync to propagate. Leave empty in production.
DEV_GUILD_ID=

# Optional: a channel ID (in your own server) that receives uncaught errors
# which can't be attributed to a specific guild's configured error channel.
BOT_ERROR_CHANNEL_ID=

# Optional: a channel ID that gets a message whenever the bot restarts —
# "restarting" right before shutdown, then "restarted cleanly" or "restarted
# after an unclean shutdown" (with recent error log lines) on the next boot.
RESTART_LOG_CHANNEL_ID=

# Optional, Linux + root only: on startup, automatically run
# deploy/install.sh to install/enable the systemd service + daily restart
# timer, then exit the foreground process so systemd's copy is the only
# one running. Safe to leave set permanently — it no-ops once the bot is
# already running under systemd (detected via systemd's INVOCATION_ID),
# and no-ops entirely if not root or not on Linux. TICKETBOT_RESTART_SCHEDULE
# controls daily (default) vs weekly.
TICKETBOT_AUTO_SYSTEMD=
TICKETBOT_RESTART_SCHEDULE=daily

# Text shown in the bot's "Watching ..." presence rotation.
PRESENCE_TEXT=for /ticket setup

# Rebrands the small footer line on every panel/embed (e.g. "-# YourBrand").
BRAND_NAME=Ticket Tool
